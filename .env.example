# Copy to .env for local use. Docker Compose reads .env automatically.
# .env is gitignored. Placeholders only — never commit a real secret.

# GapGPT API key. The shared client (api/gapgpt.py) reads only this variable.
# Leave empty to boot without model calls. /health stays OK either way.
# POST /recipes/generate and POST /vision/fridge use this same key inside the api service.
# Never commit a real key. Placeholder only.
GAP_CODE_API_KEY=

# GapGPT endpoint and model. These defaults match the documented demo values.
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
GAPGPT_MODEL=gpt-5.6-luna

# Local Postgres only. Not a production secret.
# POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB are applied when the
# pgdata volume is first created. The api stores pantry chips, the week
# budget, and the 7-day plan in that database. Do not put GAP_CODE_API_KEY
# or any other secret in the database.
POSTGRES_USER=ashpaz
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ashpaz
