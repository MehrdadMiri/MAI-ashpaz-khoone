# Copy to .env for local use. Docker Compose reads .env automatically.
# .env is gitignored. Placeholders only — never commit a real secret.

# GapGPT API key. The shared client (api/gapgpt.py) reads only this variable.
# Leave empty to boot without model calls. /health stays OK either way.
# POST /recipes/generate, POST /recipes/nutrition, and POST /vision/fridge use this same key inside the api service.
# Never commit a real key. Placeholder only.
GAP_CODE_API_KEY=

# GapGPT endpoint and model. These defaults match the documented demo values.
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
GAPGPT_MODEL=gpt-5.6-luna

# Local Postgres only. Not a production secret.
# POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB are applied when the
# pgdata volume is first created. The api stores pantry chips, the week
# budget, and the 7-day plan in that database. Do not put GAP_CODE_API_KEY
# or any other secret in the database.
POSTGRES_USER=ashpaz
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ashpaz

# Okala grocery prices. No key. The refresh button is the normal path.
# OKALA_LIVE=1 calls the public catalog JSON (apigateway.okala.com) when you
# press «به‌روزرسانی قیمت‌ها». OKALA_LIVE=0 uses the bundled snapshot only.
# Prices are cached for OKALA_CACHE_TTL_SECONDS (default 24h). A second press
# inside OKALA_MIN_INTERVAL_SECONDS (default 60) does not call out again.
# OKALA_REFRESH_INTERVAL_SECONDS=0 leaves the optional timer off. A positive
# value is raised to at least 3600 seconds. Do not point these at a secret.
OKALA_LIVE=1
OKALA_CACHE_TTL_SECONDS=86400
OKALA_MIN_INTERVAL_SECONDS=60
OKALA_REQUEST_DELAY_SECONDS=1.5
OKALA_TIMEOUT_SECONDS=8
OKALA_STORE_ID=2319
OKALA_REFRESH_INTERVAL_SECONDS=0
