# Copy to .env for local use. Docker Compose reads .env automatically.
# .env is gitignored. Put placeholders here only — never real secrets.

# GapGPT API key. Optional for this scaffold: the stack starts and /health
# stays OK when this is empty. Later tickets call the model with this value.
GAP_CODE_API_KEY=your-gapgpt-api-key-here

# GapGPT endpoint and model. These defaults match the documented demo values.
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
GAPGPT_MODEL=gpt-5.6-luna

# Local Postgres only. Not a production secret.
POSTGRES_USER=ashpaz
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ashpaz
